{
  "name": "{{npmPackageName}}",
  "version": "{{version}}",
  "description": "{{description}}",
  "mcpName": "{{mcpName}}",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "{{binName}}": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('dist/index.js', '755')\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "docs": "typedoc src/index.ts --out docs/api --skipErrorChecking"
  },{{#if repositoryUrl}}
  "repository": {
    "type": "git",
    "url": "{{repositoryUrl}}"
  },{{/if}}
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "zod": "^3.24.0"{{#each dependencies}},
    "{{this}}": "*"{{/each}}
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.7.0",
    "vitest": "^3.0.0",
    "typedoc": "^0.27.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
