/**
 * Auto-generated MCP server: {{serverName}}
 * Generated by MCP Tool Factory
 *
 * Supports two transport modes:
 * - stdio (default): Standard input/output for CLI usage
 * - http: Streamable HTTP transport for web integrations
 *
 * Set MCP_TRANSPORT=http and MCP_PORT=8000 for HTTP mode.
 */

import { McpServer } from '@modelcontextprotocol/sdk/server/mcp.js';
import { StdioServerTransport } from '@modelcontextprotocol/sdk/server/stdio.js';
import { StreamableHTTPServerTransport } from '@modelcontextprotocol/sdk/server/streamableHttp.js';
import { z } from 'zod';
import { createServer as createHttpServer, IncomingMessage, ServerResponse } from 'http';

{{#if productionImports}}
{{{productionImports}}}
{{/if}}

{{#each dependencyImports}}
{{{this}}}
{{/each}}

{{#each extractedImports}}
{{{this}}}
{{/each}}

// ============== SERVER SETUP ==============

{{#if productionLogging}}
{{{productionLogging}}}
{{/if}}

{{#if productionMetrics}}
{{{productionMetrics}}}
{{/if}}

{{#if productionRateLimiting}}
{{{productionRateLimiting}}}
{{/if}}

{{#if productionRetry}}
{{{productionRetry}}}
{{/if}}

/**
 * Create and configure the MCP server.
 */
export function createServer(): McpServer {
  const server = new McpServer({
    name: '{{serverName}}',
    version: '1.0.0',
  });

{{#if authEnvVars.length}}
  // ============== AUTH CONFIGURATION ==============
  // These environment variables are required for API access

  const AUTH_CONFIG: Record<string, string | undefined> = {
  {{#each authEnvVars}}
    '{{this}}': process.env['{{this}}'],
  {{/each}}
  };

  function getAuth(key: string): string | undefined {
    return AUTH_CONFIG[key];
  }

  function requireAuth(key: string): string {
    const value = getAuth(key);
    if (!value) {
      throw new Error(`Missing required environment variable: ${key}`);
    }
    return value;
  }

{{/if}}

{{#if includeHealthCheck}}
  // ============== HEALTH CHECK ==============

  server.tool(
    'health_check',
    'Check server health and configuration status',
    {},
    async () => {
      const result: Record<string, unknown> = {
        status: 'healthy',
        server: '{{serverName}}',
        version: '1.0.0',
        uptime: process.uptime(),
        memory: process.memoryUsage().heapUsed,
        transport: process.env.MCP_TRANSPORT || 'stdio',
        timestamp: new Date().toISOString(),
        tools_available: {{toolCount}},
      };

{{#if authEnvVars.length}}
      // Check auth configuration
      const authStatus: Record<string, string> = {};
  {{#each authEnvVars}}
      authStatus['{{this}}'] = getAuth('{{this}}') ? 'configured' : 'MISSING';
  {{/each}}
      result['auth_config'] = authStatus;

      // Mark unhealthy if any auth is missing
      if (Object.values(authStatus).includes('MISSING')) {
        result['status'] = 'unhealthy';
        result['error'] = 'Missing required authentication';
      }
{{/if}}

      return { content: [{ type: 'text', text: JSON.stringify(result) }] };
    }
  );

{{/if}}

  // ============== TOOLS ==============

{{#each toolSpecs}}
  server.tool(
    '{{this.name}}',
    '{{this.description}}',
    {
  {{#each this.inputSchema.properties}}
      {{@key}}: z.{{jsonTypeToZod this.type}}(){{#if this.description}}.describe('{{this.description}}'){{/if}}{{#unless (isRequired @key ../this.inputSchema.required)}}.optional(){{/unless}},
  {{/each}}
    },
    async (params) => {
{{#if ../productionRateLimiting}}
      if (!checkRateLimit('{{this.name}}')) {
        return { content: [{ type: 'text', text: JSON.stringify({ error: 'RATE_LIMITED', message: 'Rate limit exceeded' }) }], isError: true };
      }
{{/if}}
{{#if ../productionLogging}}
      log('info', 'Tool called: {{this.name}}', { tool: '{{this.name}}' });
{{/if}}
{{#if ../productionMetrics}}
      toolCallCounter.inc({ tool: '{{this.name}}', status: 'called' });
      const __startTime = Date.now();
{{/if}}
      try {
{{{lookup ../implementations this.name}}}
      } catch (e) {
{{#if ../productionLogging}}
        log('error', 'Tool error: {{this.name}}', { tool: '{{this.name}}', error: e instanceof Error ? e.message : String(e) });
{{/if}}
{{#if ../productionMetrics}}
        toolCallCounter.inc({ tool: '{{this.name}}', status: 'error' });
{{/if}}
        return {
          content: [{
            type: 'text',
            text: JSON.stringify({ error: e instanceof Error ? e.message : String(e) })
          }]
        };
      }
{{#if ../productionMetrics}}
      finally {
        toolDurationHistogram.observe({ tool: '{{this.name}}' }, (Date.now() - __startTime) / 1000);
      }
{{/if}}
    }
  );

{{/each}}

{{#if resourceSpecs.length}}
  // ============== RESOURCES ==============

{{#each resourceSpecs}}
{{#if this.template}}
  server.resource(
    '{{this.name}}',
    '{{this.uri}}',
    { description: '{{this.description}}' },
    async (uri) => ({
      contents: [{
        uri: uri.href,
        mimeType: '{{this.mimeType}}',
        text: JSON.stringify({ uri: uri.href, note: 'TODO: Implement resource handler' }),
      }],
    })
  );
{{else}}
  server.resource(
    '{{this.name}}',
    '{{this.uri}}',
    { description: '{{this.description}}' },
    async (uri) => ({
      contents: [{
        uri: uri.href,
        mimeType: '{{this.mimeType}}',
        text: JSON.stringify({ uri: uri.href, note: 'TODO: Implement resource handler' }),
      }],
    })
  );
{{/if}}

{{/each}}
{{/if}}

{{#if promptSpecs.length}}
  // ============== PROMPTS ==============

{{#each promptSpecs}}
  server.prompt(
    '{{this.name}}',
    '{{this.description}}',
    {
{{#each this.arguments}}
      {{this.name}}: z.string(){{#unless this.required}}.optional(){{/unless}}.describe('{{this.description}}'),
{{/each}}
    },
    async (params) => ({
      messages: [{
        role: 'user',
        content: {
          type: 'text',
          text: `{{{this.template}}}`,
        },
      }],
    })
  );

{{/each}}
{{/if}}

  return server;
}

// ============== MAIN ==============

const server = createServer();

async function startStdioServer(): Promise<void> {
  const transport = new StdioServerTransport();
  await server.connect(transport);
}

async function startHttpServer(port: number): Promise<void> {
  const httpServer = createHttpServer(async (req: IncomingMessage, res: ServerResponse) => {
    const url = new URL(req.url || '/', `http://localhost:${port}`);

    // Health check endpoint
    if (url.pathname === '/health' && req.method === 'GET') {
      res.writeHead(200, { 'Content-Type': 'application/json' });
      res.end(JSON.stringify({
        status: 'healthy',
        server: '{{serverName}}',
        transport: 'http',
        timestamp: new Date().toISOString(),
      }));
      return;
    }

    // MCP endpoint - Streamable HTTP
    if (url.pathname === '/mcp') {
      const transport = new StreamableHTTPServerTransport({
        sessionIdGenerator: undefined,
      });
      await server.connect(transport);
      await transport.handleRequest(req, res);
      return;
    }

    // Not found
    res.writeHead(404, { 'Content-Type': 'application/json' });
    res.end(JSON.stringify({ error: 'Not found' }));
  });

  httpServer.listen(port, () => {
    console.log(`Streamable HTTP server listening on http://localhost:${port}`);
    console.log(`MCP endpoint: POST http://localhost:${port}/mcp`);
    console.log(`Health check: GET http://localhost:${port}/health`);
  });
}

async function main(): Promise<void> {
{{#if authEnvVars.length}}
  // Check for required auth on startup
  const AUTH_CONFIG: Record<string, string | undefined> = {
  {{#each authEnvVars}}
    '{{this}}': process.env['{{this}}'],
  {{/each}}
  };

  const missingAuth = Object.entries(AUTH_CONFIG)
    .filter(([_, v]) => !v)
    .map(([k]) => k);
  if (missingAuth.length > 0) {
    console.warn(`WARNING: Missing environment variables: ${missingAuth.join(', ')}`);
  }

{{/if}}
  const transportType = process.env.MCP_TRANSPORT || 'stdio';
  const port = parseInt(process.env.MCP_PORT || '8000', 10);

  if (transportType === 'http') {
    await startHttpServer(port);
  } else {
    await startStdioServer();
  }
}

main().catch(console.error);
